# CryptoScope AI — Environment Variables Reference Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT

ENVIRONMENT=production
PROJECT_NAME="CryptoScope AI"

# Database & TimescaleDB
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cryptoscope

# Redis (Caching, Streams, Locks, PubSub)
REDIS_URL=redis://localhost:6379/0

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-if-using-symmetric

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID=cryptoscope-ai
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json

# MLflow Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000

# Object Storage (Cloudflare R2 / AWS S3 / MinIO)
OBJECT_STORAGE_PROVIDER=s3
S3_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
S3_BUCKET=cryptoscope-data
S3_ACCESS_KEY=your-access-key-id
S3_SECRET_KEY=your-secret-access-key
S3_REGION=auto

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Security & CORS
CORS_ORIGINS=["https://cryptoscope.ai","https://app.cryptoscope.ai","http://localhost:3000"]
ALLOWED_HOSTS=["*"]
SECRET_KEY=generate_a_secure_256_bit_secret_key_for_internal_cryptography
